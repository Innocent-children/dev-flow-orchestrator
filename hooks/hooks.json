{
  "description": "Restore Dev Flow context and guard operations that must pass through the orchestrator.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10,
            "statusMessage": "Loading the active Dev Flow task"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10,
            "statusMessage": "Loading the scoped Dev Flow assignment"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10,
            "statusMessage": "Checking the Dev Flow worker result"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10,
            "statusMessage": "Finishing the Dev Flow compaction checkpoint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/dev_flow_python_launcher\" \"$PLUGIN_ROOT/hooks/dev_flow_hook.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\dev_flow_hook.cmd\"",
            "timeout": 10,
            "statusMessage": "Checking Dev Flow guardrails"
          }
        ]
      }
    ]
  }
}
