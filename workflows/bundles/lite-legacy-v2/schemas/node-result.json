{
  "$id": "dev-flow-node-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative manager-visible NodeResult",
  "type": "object",
  "x-canonicalUtf8MaxBytes": 2048,
  "x-contentAddressedIdentity": "result_id",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
    },
    "contentAddressedId": {
      "type": "string",
      "minLength": 66,
      "maxLength": 129,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "semantic_sha256": {"$ref": "#/$defs/digest"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "kind": {"$ref": "#/$defs/stableId"},
        "locator": {"$ref": "#/$defs/stableId"}
      },
      "required": [
        "id",
        "semantic_sha256",
        "sha256",
        "size",
        "kind",
        "locator"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema": {"const": "dev-flow-node-result/v1"},
    "result_id": {
      "type": "string",
      "minLength": 76,
      "maxLength": 76,
      "pattern": "^node-result-[0-9a-f]{64}$"
    },
    "task_id": {"$ref": "#/$defs/stableId"},
    "workflow_bundle_sha256": {"$ref": "#/$defs/digest"},
    "map_epoch": {"type": "integer", "minimum": 1},
    "node_instance_id": {"$ref": "#/$defs/stableId"},
    "repository_id": {
      "oneOf": [
        {"$ref": "#/$defs/stableId"},
        {"type": "null"}
      ]
    },
    "attempt": {"type": "integer", "minimum": 1},
    "assignment_id": {"$ref": "#/$defs/contentAddressedId"},
    "lease_id": {
      "oneOf": [
        {"$ref": "#/$defs/contentAddressedId"},
        {"type": "null"}
      ]
    },
    "lease_nonce": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "input_sha256": {"$ref": "#/$defs/digest"},
    "output_sha256": {"$ref": "#/$defs/digest"},
    "worktree_sha256": {"$ref": "#/$defs/digest"},
    "changed_paths_sha256": {"$ref": "#/$defs/digest"},
    "verification_sha256": {"$ref": "#/$defs/digest"},
    "outcome": {
      "type": "string",
      "enum": [
        "BLOCKED",
        "FAILED",
        "SUCCEEDED",
        "WAITING_APPROVAL",
        "WAITING_EXTERNAL"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[^\\r\\n]*$",
      "x-utf8MaxBytes": 512
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true,
      "x-canonicalUtf8Order": true
    },
    "plan_drift": {
      "type": "object",
      "properties": {
        "detected": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true,
          "x-canonicalUtf8Order": true
        }
      },
      "required": ["detected", "reasons"],
      "additionalProperties": false
    },
    "artifact_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"},
      "x-canonicalUtf8OrderBy": "id"
    },
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"},
      "x-canonicalUtf8OrderBy": "id"
    },
    "runtime_handle": {
      "oneOf": [
        {"$ref": "#/$defs/stableId"},
        {"type": "null"}
      ]
    }
  },
  "required": [
    "schema",
    "result_id",
    "task_id",
    "workflow_bundle_sha256",
    "map_epoch",
    "node_instance_id",
    "repository_id",
    "attempt",
    "assignment_id",
    "lease_id",
    "lease_nonce",
    "input_sha256",
    "output_sha256",
    "worktree_sha256",
    "changed_paths_sha256",
    "verification_sha256",
    "outcome",
    "summary",
    "blockers",
    "plan_drift",
    "artifact_refs",
    "evidence_refs",
    "runtime_handle"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "lease_id": {"type": "null"},
            "lease_nonce": {"type": "null"}
          }
        },
        {
          "properties": {
            "lease_id": {"$ref": "#/$defs/contentAddressedId"},
            "lease_nonce": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    }
  ],
  "additionalProperties": false
}
