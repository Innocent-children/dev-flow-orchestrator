{
  "$id": "dev-flow-contract-reference/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "registry": {"type": "string", "minLength": 5, "maxLength": 9, "pattern": "^(executors|gates|guards|reducers)$"},
    "id": {"type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*(/[a-z][a-z0-9._-]*)*/v[1-9][0-9]*$"},
    "version": {"type": "string", "minLength": 2, "maxLength": 16, "pattern": "^v[1-9][0-9]*$"}
  },
  "required": ["registry", "id", "version"],
  "additionalProperties": false
}
