{
  "$id": "dev-flow-node-input/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {"type": "string", "minLength": 22, "maxLength": 22, "pattern": "^dev-flow-node-input/v1$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "workflow_bundle_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "node_instance_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "input_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "context": {
      "type": "object",
      "properties": {
        "projection_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "state_paths": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/.*$"}, "minItems": 0, "maxItems": 64, "uniqueItems": true},
        "artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"}, "minItems": 0, "maxItems": 128, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"}, "minItems": 0, "maxItems": 128, "uniqueItems": true}
      },
      "required": ["projection_sha256", "state_paths", "artifact_ids", "evidence_ids"],
      "additionalProperties": false
    }
  },
  "required": ["contract", "task_id", "workflow_bundle_sha256", "node_instance_id", "attempt", "expected_revision", "input_sha256", "context"],
  "additionalProperties": false
}
